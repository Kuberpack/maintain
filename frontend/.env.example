# Only read on the Node/Vite side (dev server proxy target), never bundled to the browser.
# Used only by `vite dev` locally -- irrelevant to a production build (Vercel),
# which has no dev server/proxy at all.
VITE_BACKEND_URL=http://localhost:8000

# Read in the browser, bundled into the production build. Leave unset for
# local dev -- API calls then go through the relative /api and /uploads
# paths that vite.config.ts's dev-server proxy forwards to VITE_BACKEND_URL
# above. Set this to the deployed backend's real origin when building for a
# real deployment (Vercel), e.g. https://your-app.up.railway.app -- no
# trailing slash, no /api suffix (the backend mounts its routes at the
# root, not under /api) -- since there's no dev-server proxy there to fall
# back on.
# VITE_API_BASE_URL=https://your-app.up.railway.app
