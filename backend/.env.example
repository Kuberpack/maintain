DATABASE_URL=postgresql+psycopg2://maintain:maintain@db:5432/maintain
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
CORS_ORIGINS=["http://localhost:5173"]
ALERT_UPCOMING_DAYS=3
ALERT_OVERDUE_ESCALATE_DAYS=1
ALERT_UNREVIEWED_HOURS=8
LOCAL_TIMEZONE=Asia/Kolkata
DAILY_CHECK_HOUR=7
MAX_UPLOAD_SIZE_MB=8
UPLOADS_DIR=uploads
# Optional S3-compatible storage (Railway bucket, AWS, R2). If S3_BUCKET is set, photos go there.
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=auto
# SMTP (leave unset to keep email as a log-only stub)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
# WhatsApp: Twilio, or a generic HTTP BSP. Unset = log-only stub.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=
# WHATSAPP_API_URL=
# WHATSAPP_API_TOKEN=
# WHATSAPP_FROM=
