# Only read on the Node/Vite side (dev server proxy target), never bundled to the browser.
# Used only by `vite dev` locally -- irrelevant to a production build (Vercel),
# which has no dev server/proxy at all.
VITE_BACKEND_URL=http://localhost:8000

# Leave unset. The browser always calls same-origin /api (and /uploads).
# Locally that is proxied by vite.config.ts. On Vercel, vercel.json rewrites
# those paths to the Railway backend so company WiFi never has to reach
# *.up.railway.app.
# VITE_API_BASE_URL is unused; do not set it on Vercel.
